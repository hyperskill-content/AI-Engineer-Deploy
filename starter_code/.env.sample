OPENAI_MODEL=<openai-model>
OPENAI_EMBEDDINGS_MODEL=<openai-embedding-model>
OPENAI_BASE_URL=<openai_base_url>  # Duplicate of LITELLM_API_KEY (for Nemo Guardrails usage)
OPENAI_API_KEY=<openai_api_key>    # Duplicate of LITELLM_BASE_URL (for Nemo Guardrails usage)

# Lite LLM is a LLM proxy which provides one OpenAI-like interface with different modesl
LITELLM_API_KEY=<litellm_api_key>
LITELLM_BASE_URL=<litellm_base_url>

LANGFUSE_SECRET_KEY=<langfuse_secret_key>
LANGFUSE_PUBLIC_KEY=<langfuse_public_key>
LANGFUSE_HOST=<langfuse_host>

REDIS_CONNECTION_STRING=<redis_connection_url>
REDIS_URL=<redis_url>