# Write values without quotes: docker run --env-file passes them literally, quotes included
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-ada-002
OPENAI_BASE_URL=https://litellm.aks-hs-prod.int.hyperskill.org/openai
OPENAI_API_KEY=<>

# Langfuse Cloud project keys (Settings -> API Keys in the Langfuse Cloud project)
LANGFUSE_SECRET_KEY=<>
LANGFUSE_PUBLIC_KEY=<>
# Langfuse Cloud address for your account's region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
# The SDK reads LANGFUSE_BASE_URL first and falls back to LANGFUSE_HOST, so keep them the same
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Redis Cloud connection string for chat history: redis://<username>:<password>@<public_endpoint>:<port>/0
REDIS_URL=<>

# Qdrant Cloud cluster endpoint URL and API key, for the smartphones vector store
QDRANT_URL=<>
QDRANT_API_KEY=<>
