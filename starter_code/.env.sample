OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-ada-002
OPENAI_BASE_URL=https://your-litellm-proxy.example.com
OPENAI_API_KEY=<your-litellm-user-key>

# Qdrant Cloud cluster endpoint and API key
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# Redis Cloud connection string (database 0)
REDIS_URL=rediss://default:<your-redis-password>@your-redis-endpoint:port/0

# Langfuse Cloud project credentials
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com
